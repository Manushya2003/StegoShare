# =====================================================
# StegoShare Environment Configuration
# =====================================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# IPFS Pinata Configuration (Optional - StegoShare provides local IPFS Gateway fallback)
PINATA_JWT=YOUR_PINATA_JWT_TOKEN_HERE
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET_KEY=YOUR_PINATA_SECRET_KEY
PINATA_GATEWAY=gateway.pinata.cloud
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Blockchain & Smart Contract Configuration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_NETWORK=Hardhat Localhost (Chain ID: 31337)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
